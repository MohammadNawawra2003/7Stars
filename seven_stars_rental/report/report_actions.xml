<?xml version="1.0" encoding="utf-8"?>
<odoo>

<!-- The eight documents of PRD §10-§16 (spec §10). All qweb-pdf, all A4 via
     base.paperformat_euro, all rendered through web.external_layout.

     ir.actions.report restricts visibility with group_ids — ir.rule uses `groups`, which is
     a different name for the same kind of m2m. -->

<record id="action_report_hall_contract" model="ir.actions.report">
    <field name="name">عقد استئجار القاعة (زفاف)</field>
    <field name="model">sale.order</field>
    <field name="report_type">qweb-pdf</field>
    <field name="report_name">seven_stars_rental.report_hall_contract</field>
    <field name="report_file">seven_stars_rental.report_hall_contract</field>
    <field name="paperformat_id" ref="base.paperformat_euro"/>
    <field name="print_report_name">'عقد زفاف - %s' % (object.name)</field>
    <field name="binding_model_id" ref="sale.model_sale_order"/>
    <field name="binding_type">report</field>
</record>

