<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- The three contracts Seven Stars signs (PRD §10). A booking may carry more than one —
         a wedding with a henna night and a lunch — which is Jamal's «امكانية اختيار أكثر من
         نوع» of 2026-09-23.

         `body` ships EMPTY on purpose: the wording is the client's own (spec Appendix A) and
         none has been drafted for them. Each contract prints a visible placeholder until its
         text is entered at قاعات سفن ستارز ▸ الإعدادات ▸ نصوص العقود.

         noupdate so that text, once entered, survives every upgrade. -->
    <data noupdate="1">

        <record id="contract_type_wedding" model="seven.stars.contract.type">
            <field name="name">عقد استئجار القاعة — زفاف</field>
            <field name="sequence" eval="10"/>
            <field name="report_id" ref="action_report_hall_contract"/>
        </record>

        <record id="contract_type_henna" model="seven.stars.contract.type">
            <field name="name">عقد استئجار قاعة — حنة</field>
            <field name="sequence" eval="20"/>
            <field name="report_id" ref="action_report_henna_contract"/>
        </record>

        <record id="contract_type_lunch" model="seven.stars.contract.type">
            <field name="name">عقد خدمات غداء</field>
            <field name="sequence" eval="30"/>
            <field name="report_id" ref="action_report_lunch_contract"/>
        </record>

    </data>
</odoo>
