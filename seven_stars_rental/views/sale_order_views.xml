<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- SCR-02. The booking form is the standard rental order form plus this inherit.
         No new screen is created anywhere in this project (spec §9). -->
    <record id="view_order_form_seven_stars" model="ir.ui.view">
        <field name="name">sale.order.form.seven.stars</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">

            <!-- The seven custom buttons (spec §9.1). Eight states minus `draft`, which is
                 where a booking is created, leaves exactly seven transitions. Print, the
                 standard confirm and the chatter are reused as they are and not counted. -->
            <xpath expr="//header/field[@name='state']" position="before">
                <button name="action_hold_tentative" type="object" class="btn-primary"
                        string="حجز مبدئي"
                        invisible="not is_rental_order or booking_state != 'draft'"/>
                <button name="action_await_deposit" type="object" class="btn-primary"
                        string="انتظار العربون وتوقيع العقد"
                        invisible="not is_rental_order or booking_state != 'tentative'"/>
                <button name="action_confirm_booking" type="object" class="btn-primary"
                        string="تأكيد الحجز"
                        invisible="not is_rental_order or booking_state != 'awaiting'"/>
                <button name="action_mark_ready" type="object" class="btn-primary"
                        string="جاهز للمناسبة"
                        invisible="not is_rental_order or booking_state != 'confirmed'"/>
                <button name="action_close_booking" type="object" class="btn-primary"
                        string="إغلاق الحجز"
                        invisible="not is_rental_order or booking_state != 'ready'"/>
                <button name="action_postpone" type="object"
                        string="تأجيل"
                        invisible="not is_rental_order or booking_state not in ('confirmed', 'ready')"/>
                <button name="action_cancel_booking" type="object"
                        string="إلغاء الحجز"
                        groups="seven_stars_rental.group_ss_booking_manager"
                        invisible="not is_rental_order or booking_state in ('cancelled', 'completed')"/>
                <button name="action_ss_print_contracts" type="object"
                        string="طباعة العقود"
                        invisible="not is_rental_order or not contract_report_ids"/>

                <!-- The eight PRD states, alongside the standard four. They are independent
                     fields and were verified coexisting at runtime (T4). -->
                <field name="booking_state" widget="statusbar"
                       invisible="not is_rental_order"
                       statusbar_visible="draft,tentative,awaiting,confirmed,ready,completed"/>
            </xpath>

            <!-- Invoicing is AUTOMATIC on «مؤكد» (Jamal, 2026-09-23), so the manual buttons
                 stay hidden on a rental order: pressing them would raise a second invoice
                 for a booking that already has one. The invoice is reached through the
                 standard Invoices smart button. Untouched on every other order. -->
            <xpath expr="//button[@id='create_invoice']" position="attributes">
                <attribute name="invisible">invoice_status != 'to invoice' or is_rental_order</attribute>
            </xpath>
            <xpath expr="//button[@id='create_invoice_percentage']" position="attributes">
                <attribute name="invisible">invoice_status != 'no' or state != 'sale' or is_rental_order</attribute>
            </xpath>

            <!-- The figures staff actually look for, on the form itself rather than a tab —
                 the shape Jamal asked for on 2026-09-23. -->
            <xpath expr="//group[@name='order_details']" position="inside">
                <field name="groom_name" invisible="not is_rental_order or event_type != 'wedding'"/>
                <field name="bride_name" invisible="not is_rental_order or event_type != 'wedding'"/>
                <field name="hall_ids" widget="many2many_tags" options="{'no_create': True}"
                       invisible="not is_rental_order" readonly="state in ('sale', 'cancel')"/>
                <field name="collected_amount" invisible="not is_rental_order"/>
                <field name="outstanding_amount" invisible="not is_rental_order"
                       decoration-danger="outstanding_amount &gt; 0"
                       decoration-success="outstanding_amount &lt;= 0"/>
            </xpath>

            <xpath expr="//notebook/page[@name='order_lines']" position="before">
                <page string="الحجز" name="ss_booking" invisible="not is_rental_order">
                    <group>
                        <group string="المناسبة">
                            <field name="event_type"/>
                            <field name="guest_count"/>
                            <!-- hall_ids lives on the form header above, where staff look
                                 for it. Picking one writes its rental line, priced by the
                                 booking's pricelist. -->
                            <field name="contract_report_ids" widget="many2many_tags"
                                   options="{'no_create': True}"/>
                        </group>
                        <group string="بيانات العميل">
                            <!-- Stored on the customer; shown here because the contracts
                                 print them and nobody opens the partner form mid-booking. -->
                            <field name="partner_street"/>
                            <field name="partner_whatsapp"/>
                            <field name="partner_id_number"/>
                            <field name="partner_responsible_person"/>
                        </group>
                    </group>
                    <group>
                        <group string="ملاحظات داخلية">
                            <field name="internal_note_men" nolabel="1"
                                   placeholder="ملاحظات قاعة الرجال…"/>
                            <field name="internal_note_women" nolabel="1"
                                   placeholder="ملاحظات قاعة النساء…"/>
                        </group>
                    </group>
                </page>

                <!-- Payments. These rows are the ONLY record of money actually received
                     (spec §6.1); everything beside them is a stored compute over them. -->
                <page string="الدفعات" name="ss_payments" invisible="not is_rental_order">
                    <group>
                        <group string="شروط الدفع">
                            <!-- The same field twice, so the restriction is VISIBLE without
                                 costing a field: management edits it, everyone else reads
                                 it. This is a courtesy — sale.order.write() is what actually
                                 enforces it over RPC (PRD §17). -->
                            <field name="required_deposit_amount"
                                   groups="seven_stars_rental.group_ss_manager"/>
                            <field name="required_deposit_amount" readonly="1"
                                   groups="!seven_stars_rental.group_ss_manager"/>
                            <field name="price_approved"
                                   groups="seven_stars_rental.group_ss_manager"/>
                        </group>
                        <group string="الحساب">
                            <field name="amount_total" string="الإجمالي" readonly="1"/>
                            <field name="collected_amount" readonly="1"/>
                            <field name="outstanding_amount" readonly="1"
                                   decoration-danger="outstanding_amount &gt; 0"
                                   decoration-success="outstanding_amount &lt;= 0"/>
                        </group>
                    </group>
                    <button name="%(seven_stars_rental.action_ss_payment_register)d"
                            type="action" string="تسجيل دفعة" class="btn-primary"
                            icon="fa-money"/>
                    <!-- Real account.payment records. Read-only here: money is taken through
                         the wizard, which posts it and settles it against the invoice. -->
                    <field name="payment_ids" readonly="1">
                        <list>
                            <field name="date"/>
                            <field name="amount"/>
                            <field name="payment_type"/>
                            <field name="journal_id"/>
                            <field name="memo"/>
                            <field name="state"/>
                            <field name="currency_id" column_invisible="True"/>
                        </list>
                    </field>
                </page>

                <!-- The operational appendix, in the order of the paper form (RPT-04). -->
                <page string="الملحق التشغيلي" name="ss_appendix" invisible="not is_rental_order">
                    <group>
                        <group string="المناسبة والعروض">
                            <field name="appendix_event_date"/>
                            <field name="appendix_promo_show"/>
                            <field name="appendix_dabke_women"/>
                            <field name="appendix_zaffa_groom"/>
                            <field name="appendix_zaffa_on_screens"/>
                            <field name="appendix_lighting"/>
                        </group>
                        <group string="الضيافة والتوزيعات">
                            <field name="appendix_hospitality_men"/>
                            <field name="appendix_hospitality_women"/>
                            <field name="appendix_hospitality_time"/>
                            <field name="appendix_giveaways"/>
                        </group>
                        <group string="الطاولات">
                            <field name="appendix_tables_groom"/>
                            <field name="appendix_tables_bride"/>
                        </group>
                        <group string="الخدمات المساندة">
                            <field name="appendix_security"/>
                            <field name="appendix_photo_studio"/>
                        </group>
                    </group>
                    <group string="التفاصيل">
                        <field name="appendix_details" nolabel="1"
                               placeholder="تفاصيل إضافية ليوم المناسبة…"/>
                    </group>
                </page>
            </xpath>

        </field>
    </record>

</odoo>
