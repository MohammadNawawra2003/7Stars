<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_ss_contract_type_list" model="ir.ui.view">
        <field name="name">seven.stars.contract.type.list</field>
        <field name="model">seven.stars.contract.type</field>
        <field name="arch" type="xml">
            <list string="نصوص العقود">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="report_id"/>
            </list>
        </field>
    </record>

    <record id="view_ss_contract_type_form" model="ir.ui.view">
        <field name="name">seven.stars.contract.type.form</field>
        <field name="model">seven.stars.contract.type</field>
        <field name="arch" type="xml">
            <form string="نوع العقد">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="report_id" options="{'no_create': True}"/>
                        <field name="active" invisible="1"/>
                    </group>
                    <group string="نص العقد">
                        <field name="body" nolabel="1"
                               placeholder="ألصق هنا نص الاتفاقية المعتمد من إدارة قاعات سفن ستارز — التمهيد والبنود المرقّمة. يُطبع بين «أولاً: مقدمة الاتفاقية» و«رابعاً: التوقيعات»، ولا يحتاج أي تعديل برمجي."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_ss_contract_types" model="ir.actions.act_window">
        <field name="name">نصوص العقود</field>
        <field name="res_model">seven.stars.contract.type</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smart_button">لا توجد أنواع عقود</p>
            <p>نص كل عقد يُكتب هنا ويُطبع كما هو. لا يحتاج أي تعديل برمجي.</p>
        </field>
    </record>

</odoo>
