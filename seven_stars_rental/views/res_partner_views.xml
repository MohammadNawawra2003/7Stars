<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- SCR-05. The three details the contracts need and the standard contact does not have. -->
    <record id="view_partner_form_seven_stars" model="ir.ui.view">
        <field name="name">res.partner.form.seven.stars</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='contact_addresses']" position="before">
                <page string="بيانات المناسبات" name="ss_customer">
                    <group>
                        <group>
                            <field name="id_number"/>
                            <field name="whatsapp" class="o_force_ltr"/>
                        </group>
                        <group>
                            <field name="responsible_person"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
