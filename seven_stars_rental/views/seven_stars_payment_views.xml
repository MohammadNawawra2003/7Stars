<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Payments get their own screens so the accountant can work from the money side
         instead of opening bookings one at a time. The rows are the same ones that appear
         in the booking's Payments tab — there is still exactly one ledger (spec §6.1). -->

    <record id="view_seven_stars_payment_list" model="ir.ui.view">
        <field name="name">seven.stars.payment.list</field>
        <field name="model">seven.stars.payment</field>
        <field name="arch" type="xml">
            <list string="الدفعات" sample="1">
                <field name="date"/>
                <field name="order_id"/>
                <field name="reference"/>
                <field name="method"/>
                <field name="amount" sum="الإجمالي"/>
                <field name="currency_id" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_seven_stars_payment_form" model="ir.ui.view">
        <field name="name">seven.stars.payment.form</field>
        <field name="model">seven.stars.payment</field>
        <field name="arch" type="xml">
            <form string="دفعة">
                <sheet>
                    <group>
                        <group>
                            <field name="order_id"/>
                            <field name="date"/>
                            <field name="method"/>
                        </group>
                        <group>
                            <field name="amount"/>
                            <field name="reference"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_seven_stars_payment_search" model="ir.ui.view">
        <field name="name">seven.stars.payment.search</field>
        <field name="model">seven.stars.payment</field>
        <field name="arch" type="xml">
            <search string="الدفعات">
                <field name="order_id"/>
                <field name="reference"/>
                <filter name="cash" string="نقداً" domain="[('method', '=', 'cash')]"/>
                <filter name="transfer" string="حوالة بنكية" domain="[('method', '=', 'transfer')]"/>
                <separator/>
                <filter name="refunds" string="مبالغ مستردة" domain="[('amount', '&lt;', 0)]"/>
                <group>
                    <filter name="group_order" string="الحجز" context="{'group_by': 'order_id'}"/>
                    <filter name="group_method" string="طريقة الدفع" context="{'group_by': 'method'}"/>
                    <filter name="group_date" string="التاريخ" context="{'group_by': 'date'}"/>
                </group>
            </search>
        </field>
    </record>

</odoo>
