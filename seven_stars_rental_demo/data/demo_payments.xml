<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Payment history. Every shekel that arrives is one row here and nowhere else — this
         is the only source of truth for money actually received (spec §6.1). collected_amount
         and outstanding_amount on the booking are stored computes over these rows, so the
         two can never drift apart, and no "is this the deposit?" flag exists: the deposit is
         simply the first payment, and the confirmation gate only ever asks how much has
         arrived in total.

         Deliberate coverage:
           completed bookings  balance driven to exactly 0.00
           booking_008         READY and fully settled, so «إغلاق الحجز» works on it today
           confirmed bookings  deposit received, balance still open
           awaiting bookings   NO rows at all — that is what "awaiting the deposit" means
           tentative / draft   no money has been discussed yet
    -->
    <record id="payment_001_1" model="seven.stars.payment">
        <field name="order_id" ref="booking_001"/>
        <field name="date">2025-12-10</field>
        <field name="amount" eval="3000.0"/>
        <field name="method">cash</field>
        <field name="reference">REC-2025-001</field>
    </record>
