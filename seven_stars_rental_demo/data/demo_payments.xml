<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Payment history, as real accounting. Jamal, 2026-09-23: payments post to the books,
         land on the customer's receivable, and are settled from the contract's invoice.

         Each row is an account.payment. The journal carries the method — a cash journal for
         نقداً, a bank journal for حوالة بنكية — so no parallel "method" field exists.
         collected_amount and outstanding_amount on the booking are stored computes over
         these, so the two can never drift apart.

         Deliberate coverage:
           completed bookings  balance driven to exactly 0.00
           booking_008         READY and fully settled, so «إغلاق الحجز» works on it today
           confirmed bookings  deposit received, balance still open
           awaiting bookings   NO rows at all — that is what "awaiting the deposit" means
           tentative / draft   no money has been discussed yet

         ⚠ A payment only counts once POSTED, and a booking only owes money once INVOICED,
         so both happen below. action_post and _ss_invoice_booking are not @api.model, so
         the first eval argument is consumed as the recordset ids — which is exactly what is
         wanted here, and why neither call passes anything else.
    -->
    <!-- A brand new database has no chart of accounts while module data loads — Odoo applies
         it only in _register_hook, after every module. Without this there are no journals and
         no receivable account, and not one payment below could be created. A no-op on every
         database that already has a chart, which is all of them after the first build. -->
    <function model="res.company" name="_ss_ensure_accounting" eval="[]"/>

    <!-- Odoo's default chart ships a bank journal but no cash journal, and a hall takes
         most of its money in cash. -->
    <record id="journal_cash" model="account.journal">
        <field name="name">النقدية</field>
        <field name="code">CSH</field>
        <field name="type">cash</field>
    </record>

