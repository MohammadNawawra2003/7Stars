<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Thirty-two bookings across the scenario matrix of spec §18: every one of the eight
         booking states, single-hall and multi-hall, past and future, each pricelist family,
         and same-day pairs in DIFFERENT halls (which is the only same-day pairing the 4h
         preparation and 5h cleanup buffers allow).

         No record here overlaps another on the same hall. Conflicts are exercised in
         tests/, never shipped as data — CON-01 would refuse them and the addon would fail
         to install, which is exactly the guarantee this file relies on.

         Deposits, payments and balances arrive in Phase 2 with seven.stars.payment.
    -->

    <record id="booking_001" model="sale.order">
        <field name="partner_id" ref="partner_customer_001"/>
        <field name="is_rental_order" eval="True"/>
        <field name="pricelist_id" ref="pricelist_wedding_pair"/>
        <field name="rental_start_date">2026-05-15 15:00:00</field>
        <field name="rental_return_date">2026-05-15 20:00:00</field>
        <field name="event_type">wedding</field>
        <field name="guest_count" eval="800"/>
        <field name="required_deposit_amount" eval="3000.0"/>
        <field name="booking_state">completed</field>
        <field name="internal_note_men">زفاف مكتمل — قاعتا 3+4</field>
        <field name="order_line" eval="[
            (0, 0, {
            'product_id': ref('hall_3_product'),
            'product_uom_qty': 1,
