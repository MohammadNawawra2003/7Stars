    </record>
    <record id="service_009" model="product.template">
        <field name="name">أمن إضافي للقاعة</field>
        <field name="default_code">SS-SRV-009</field>
        <field name="type">service</field>
        <field name="categ_id" ref="product_category_service"/>
        <field name="list_price" eval="600.0"/>
        <field name="taxes_id" eval="[(6, 0, [])]"/>
    </record>
    <record id="service_010" model="product.template">
        <field name="name">تنسيق زهور وديكور الطاولات</field>
        <field name="default_code">SS-SRV-010</field>
        <field name="type">service</field>
