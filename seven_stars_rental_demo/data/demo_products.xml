        <field name="default_code">SS-SRV-002</field>
        <field name="type">service</field>
        <field name="categ_id" ref="product_category_service"/>
        <field name="list_price" eval="1200.0"/>
        <field name="ss_appendix_item">dabke_women</field>
        <field name="taxes_id" eval="[(6, 0, [])]"/>
