    </record>
    <record id="service_005" model="product.template">
        <field name="name">عرض برومو على الشاشات</field>
        <field name="default_code">SS-SRV-005</field>
        <field name="type">service</field>
        <field name="categ_id" ref="product_category_service"/>
        <field name="list_price" eval="500.0"/>
