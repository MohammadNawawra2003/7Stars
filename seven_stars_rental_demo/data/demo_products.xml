    </record>

    <!-- ================================================================
         PACKAGES — one agreed price; the components are listed on the booking as
         note lines (display_type='line_note'), which keeps the order total exact.
         Odoo 19's Combo type is NOT used: its semantics are "pick one per group",
         so a nine-service fixed package would need nine groups with meaningless
         split prices, and a rental product cannot be a combo at all (spec Appendix A §14).
         ================================================================ -->

    <record id="package_001" model="product.template">
        <field name="name">بكج زفاف قياسي (9 خدمات)</field>
        <field name="default_code">SS-PKG-001</field>
        <field name="type">service</field>
        <field name="categ_id" ref="product_category_service"/>
        <field name="list_price" eval="14000.0"/>
        <field name="taxes_id" eval="[(6, 0, [])]"/>
    </record>
    <record id="package_002" model="product.template">
        <field name="name">بكج حنة</field>
        <field name="default_code">SS-PKG-002</field>
        <field name="type">service</field>
        <field name="categ_id" ref="product_category_service"/>
        <field name="list_price" eval="4500.0"/>
        <field name="taxes_id" eval="[(6, 0, [])]"/>
    </record>
    <record id="package_003" model="product.template">
        <field name="name">بكج غداء</field>
        <field name="default_code">SS-PKG-003</field>
        <field name="type">service</field>
        <field name="categ_id" ref="product_category_service"/>
        <field name="list_price" eval="3500.0"/>
        <field name="taxes_id" eval="[(6, 0, [])]"/>
    </record>

    <!-- product.product aliases. A booking line carries a product.product, while every record
         above is a product.template. This is the standard Odoo idiom for addressing the single
         variant of a template — sale_renting/data/rental_demo.xml uses the same call. It
         creates XML IDs; it is not business logic. -->
    <function model="ir.model.data" name="_update_xmlids">
        <value model="base" eval="[
            {'xml_id': 'seven_stars_rental_demo.hall_1_product',
             'record': obj().env.ref('seven_stars_rental_demo.hall_1').product_variant_id,
             'noupdate': False},
            {'xml_id': 'seven_stars_rental_demo.hall_2_product',
             'record': obj().env.ref('seven_stars_rental_demo.hall_2').product_variant_id,
             'noupdate': False},
            {'xml_id': 'seven_stars_rental_demo.hall_3_product',
             'record': obj().env.ref('seven_stars_rental_demo.hall_3').product_variant_id,
             'noupdate': False},
            {'xml_id': 'seven_stars_rental_demo.hall_4_product',
             'record': obj().env.ref('seven_stars_rental_demo.hall_4').product_variant_id,
             'noupdate': False},
            {'xml_id': 'seven_stars_rental_demo.service_001_product',
             'record': obj().env.ref('seven_stars_rental_demo.service_001').product_variant_id,
             'noupdate': False},
            {'xml_id': 'seven_stars_rental_demo.service_002_product',
             'record': obj().env.ref('seven_stars_rental_demo.service_002').product_variant_id,
             'noupdate': False},
            {'xml_id': 'seven_stars_rental_demo.service_003_product',
             'record': obj().env.ref('seven_stars_rental_demo.service_003').product_variant_id,
             'noupdate': False},
            {'xml_id': 'seven_stars_rental_demo.service_004_product',
             'record': obj().env.ref('seven_stars_rental_demo.service_004').product_variant_id,
             'noupdate': False},
            {'xml_id': 'seven_stars_rental_demo.service_005_product',
             'record': obj().env.ref('seven_stars_rental_demo.service_005').product_variant_id,
             'noupdate': False},
            {'xml_id': 'seven_stars_rental_demo.service_006_product',
             'record': obj().env.ref('seven_stars_rental_demo.service_006').product_variant_id,
             'noupdate': False},
            {'xml_id': 'seven_stars_rental_demo.service_007_product',
             'record': obj().env.ref('seven_stars_rental_demo.service_007').product_variant_id,
             'noupdate': False},
            {'xml_id': 'seven_stars_rental_demo.service_008_product',
             'record': obj().env.ref('seven_stars_rental_demo.service_008').product_variant_id,
             'noupdate': False},
            {'xml_id': 'seven_stars_rental_demo.service_009_product',
             'record': obj().env.ref('seven_stars_rental_demo.service_009').product_variant_id,
             'noupdate': False},
            {'xml_id': 'seven_stars_rental_demo.service_010_product',
             'record': obj().env.ref('seven_stars_rental_demo.service_010').product_variant_id,
             'noupdate': False},
            {'xml_id': 'seven_stars_rental_demo.service_011_product',
             'record': obj().env.ref('seven_stars_rental_demo.service_011').product_variant_id,
             'noupdate': False},
            {'xml_id': 'seven_stars_rental_demo.package_001_product',
             'record': obj().env.ref('seven_stars_rental_demo.package_001').product_variant_id,
             'noupdate': False},
            {'xml_id': 'seven_stars_rental_demo.package_002_product',
             'record': obj().env.ref('seven_stars_rental_demo.package_002').product_variant_id,
             'noupdate': False},
            {'xml_id': 'seven_stars_rental_demo.package_003_product',
             'record': obj().env.ref('seven_stars_rental_demo.package_003').product_variant_id,
             'noupdate': False}
        ]"/>
    </function>

</odoo>
