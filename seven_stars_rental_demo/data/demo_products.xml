    <record id="service_006" model="product.template">
        <field name="name">ضيافة إضافية — قاعة الرجال</field>
        <field name="default_code">SS-SRV-006</field>
        <field name="type">service</field>
        <field name="categ_id" ref="product_category_service"/>
        <field name="list_price" eval="2000.0"/>
        <field name="taxes_id" eval="[(6, 0, [])]"/>
    </record>
    <record id="service_007" model="product.template">
        <field name="name">ضيافة إضافية — قاعة النساء</field>
        <field name="default_code">SS-SRV-007</field>
        <field name="type">service</field>
        <field name="categ_id" ref="product_category_service"/>
        <field name="list_price" eval="2000.0"/>
        <field name="taxes_id" eval="[(6, 0, [])]"/>
    </record>
    <record id="service_008" model="product.template">
        <field name="name">توزيعات للضيوف</field>
        <field name="default_code">SS-SRV-008</field>
        <field name="type">service</field>
        <field name="categ_id" ref="product_category_service"/>
        <field name="list_price" eval="700.0"/>
